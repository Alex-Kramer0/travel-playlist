# Copy this file to .streamlit/secrets.toml and fill in your credentials.
# secrets.toml is gitignored — never commit real credentials.
#
# On Streamlit Community Cloud, add these as secrets in the app settings UI
# (Settings → Secrets) instead of using this file.

SPOTIFY_CLIENT_ID = "your_spotify_client_id"
SPOTIFY_CLIENT_SECRET = "your_spotify_client_secret"
SPOTIFY_REDIRECT_URI = "https://your-app-name.streamlit.app"
